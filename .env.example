# GridForge local development settings.
# Copy to .env, which is gitignored: cp .env.example .env
# These credentials and values are for local development only.

GRIDFORGE_ENV=local
GRIDFORGE_HTTP_ADDR=0.0.0.0:8080
GRIDFORGE_ORG_ID=00000000-0000-0000-0000-000000000001
RUST_LOG=info,gridforge=debug

# Local Postgres started by `just up`.
POSTGRES_USER=gridforge
POSTGRES_PASSWORD=gridforge
POSTGRES_DB=gridforge
DATABASE_URL=postgres://gridforge:gridforge@localhost:5432/gridforge

# Kafka-compatible broker used from the telemetry milestone onward.
GRIDFORGE_KAFKA_BROKERS=localhost:9092

# Simulator defaults. Duration 0 means run until interrupted.
GRIDFORGE_SIMULATOR_DEVICES=20
GRIDFORGE_SIMULATOR_INTERVAL_MS=1000
GRIDFORGE_SIMULATOR_DURATION_SECS=0

# Required when operator login is enabled. There are no safe defaults.
GRIDFORGE_OIDC_ISSUER_URL=
GRIDFORGE_OIDC_CLIENT_ID=
GRIDFORGE_OIDC_CLIENT_SECRET=
