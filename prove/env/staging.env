# Staging (k3d + Argo CD). From the laptop, port-forward first:
#   kubectl -n staging port-forward svc/gridforge-staging 8080:8080
# Inside the cluster the proof Job sets BASE_URL to the service DNS name.
BASE_URL=http://localhost:8080
KUBE_NAMESPACE=staging
PROD_NAMESPACE=prod
GH_REPO=iilish/grid-forge
PROVE_DEPLOYMENT=gridforge-staging
PROVE_POSTGRES_STATEFULSET=postgres
